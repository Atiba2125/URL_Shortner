# Copy to .env and edit.
DATABASE_URL=postgresql+psycopg://shortener:CHANGE_ME@localhost:5432/shortener
BASE_URL=https://xyz.com
CODE_LENGTH=6
MAX_URL_LENGTH=2048
# Comma-separated hostnames. Empty = any public http/https URL is accepted.
# Example for the Google use case: www.google.com,google.com
ALLOWED_HOSTS=

# Admin panel at /admin (HTTP Basic login). Empty password = admin panel disabled.
# Use a long random password, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Max links one IP can create per minute (0 = unlimited).
RATE_LIMIT_PER_MINUTE=30
