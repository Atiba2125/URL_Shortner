# /etc/systemd/system/shortener.service
[Unit]
Description=URL shortener (FastAPI)
After=network.target postgresql.service

[Service]
User=shortener
WorkingDirectory=/opt/shortener
EnvironmentFile=/opt/shortener/.env
ExecStart=/opt/shortener/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
